# EasyBackup only listens on loopback by default.
EASYBACKUP_HOST=127.0.0.1
EASYBACKUP_PORT=8765
EASYBACKUP_DATA_DIR=./easybackup-data
EASYBACKUP_TIMEZONE=Asia/Shanghai
EASYBACKUP_LOG_LEVEL=INFO
EASYBACKUP_SCRUB_SCHEDULE=0 3 * * sun
# EASYBACKUP_ALLOWED_HOSTS=backup-console.example.internal
# Retry deferred crash-recovery reconciliation while the service is running.
EASYBACKUP_RECONCILE_INTERVAL=60

# Optional explicit xdelta3 executable. When omitted, EasyBackup checks PATH
# and active/base Conda locations (including Library/bin on Windows).
# EASYBACKUP_XDELTA3_PATH=C:\Users\name\miniconda3\Library\bin\xdelta3.exe

# Required when binding to a non-loopback interface.
# EASYBACKUP_API_TOKEN=replace-with-a-long-random-token

# auto prefers the operating-system keyring and falls back to a
# machine-bound AES-256-GCM file when the keyring is unavailable.
EASYBACKUP_CREDENTIAL_BACKEND=auto
