@startuml
!pragma layout smetana
title EasyBackup 系统上下文与部署边界

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 14
skinparam linetype ortho
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontColor #0F172A
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.4
skinparam componentStyle rectangle
skinparam ComponentBorderColor #64748B
skinparam ComponentBackgroundColor #EFF6FF
skinparam NodeBorderColor #64748B
skinparam NodeBackgroundColor #F8FAFC
skinparam DatabaseBorderColor #2563EB
skinparam DatabaseBackgroundColor #EFF6FF
skinparam CloudBorderColor #16A34A
skinparam CloudBackgroundColor #F0FDF4
skinparam FolderBorderColor #7C3AED
skinparam FolderBackgroundColor #FAF5FF
skinparam NoteBorderColor #F59E0B
skinparam NoteBackgroundColor #FFFBEB

actor "操作者" as Operator
node "浏览器 / 终端 / 托盘" as Client
folder "源目录" as Source

node "EasyBackup 主机\nWindows / Linux / macOS" as Host {
  component "EasyBackup 进程\n────────\nWeb UI + FastAPI\n调度与任务编排\n备份 / 恢复 / 巡检 / 保留" as App
  database "SQLite（WAL）\n任务 · 快照 · 文件版本 · 操作" as SQLite
  folder "数据目录\nlogs · locks · secrets · delta-cache" as DataDir
  component "CredentialStore" as Credentials
}

node "操作系统凭据服务\nKeyring / Credential Manager" as Keyring
folder "本地备份仓库" as LocalStore
cloud "S3 兼容对象存储\nAWS S3 · MinIO · OSS*" as S3Store

Operator --> Client
Client --> App : loopback HTTP / WebSocket\n或进程内 CLI / 托盘
Source --> App : 只读扫描与固定文件读取
App --> SQLite : 短事务 / 状态事实来源
App --> DataDir : 日志、本机锁、可重建缓存
App --> Credentials : 按 Profile 解析凭据
Credentials --> Keyring : 优先
Credentials --> DataDir : 机器绑定加密文件回退
App --> LocalStore : BlobStore 文件系统适配器
App --> S3Store : HTTPS / multipart\n条件写入租约

note bottom of Client
  默认地址：http://127.0.0.1:8765
  非 loopback 监听必须配置 API Token，
  并应置于可信 TLS 反向代理之后。
end note

note bottom of LocalStore
  本地仓库与 S3 使用同一对象协议：
  volumes / patches / manifest.json / commit.json。
end note

note bottom of S3Store
  一个任务前缀应由一个权威 SQLite / 写入主机管理。
  远端租约降低冲突，但不是严格 fencing token。
end note

@enduml
